# Database Configuration (PostgreSQL Async)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/adaptivetrust

# Redis Configuration
REDIS_URL=redis://localhost:6379/0

# Security (JWT & Encryption)
JWT_SECRET_KEY=replace_this_with_a_secure_random_key_in_production_32_chars_at_least
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
